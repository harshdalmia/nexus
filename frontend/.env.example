# Copy to `.env.local` for local work. Every value here is read at BUILD time
# (Vite inlines `import.meta.env.*`), so a static deploy is configured by the
# environment of the build, not of the server.

# ---------------------------------------------------------------------------
# Engine location
# ---------------------------------------------------------------------------
# Where the FastAPI engine lives. Unset defaults to http://127.0.0.1:8000.
VITE_API_BASE_URL=http://127.0.0.1:8000

# ---------------------------------------------------------------------------
# Demo mode
# ---------------------------------------------------------------------------
# The app shows bundled demo data in exactly two situations:
#
#   1. the engine cannot be reached (probed, failed), or
#   2. demo mode is declared here or in the URL.
#
# It does NOT show demo data while the engine's state is still unknown, or while
# a reachable engine is loading its dataset — those render a placeholder, so a
# bundled figure is never mistaken for a live one.
#
# Set to 1 for a deployment with no engine behind it. The app then makes no
# network calls at all and labels every panel as demo data.
VITE_DEMO_MODE=0

# Leaving VITE_API_BASE_URL empty is an equivalent way to say "no engine":
#   VITE_API_BASE_URL=
#
# Per-visit override, no rebuild needed — useful for demos and for smoke-testing
# a demo build against a real engine:
#   ?demo=1   force bundled demo data
#   ?demo=0   force the engine, even in a demo build

# ---------------------------------------------------------------------------
# Hosting sub-path
# ---------------------------------------------------------------------------
# Only needed when the app is not served from the domain root. For a GitHub Pages
# project site at https://user.github.io/hack/ set this to `hack`.
# Leave empty for Vercel, Netlify, a container, or any root deployment.
VITE_BASE_PATH=
