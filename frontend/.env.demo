# Build profile for a standalone demo deployment: `npm run build:demo`.
#
# Committed on purpose — it carries no secrets, and a demo build should be
# reproducible from the repo alone.
#
# Declaring demo mode here means the app never probes for an engine, so there
# are no failed requests in the console and no wait before the first panel
# resolves. Every figure is labelled as demo data in the UI.
VITE_DEMO_MODE=1

# No engine to point at. Blank is also read as "no engine configured".
VITE_API_BASE_URL=

# Set to the repository name for a GitHub Pages project site, e.g. `hack`.
# Leave empty for Vercel, Netlify, or a container.
VITE_BASE_PATH=
